# weave+ server environment
# Copy to .env and fill in. Everything here is read on the server only.

# ---- Database and auth (Supabase project you own) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI (any OpenAI compatible endpoint) ----
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Google Sheets onboarding log (service account you own) ----
# Paste the whole downloaded key file on one line, or use the two vars below.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ---- Per user Google connections (Drive, Gmail, Calendar) ----
# Authorized redirect URI: https://your-domain/oauth/google/return
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts stored Google refresh tokens. openssl rand -base64 32
APP_USER_CONNECTION_KEY_SECRET=
